{
  "name": "devdash",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/devdash-shared",
    "packages/devdash-agent"
  ],
  "scripts": {
    "dev": "node scripts/kill-port.js && concurrently -n web,ws -c blue,green \"next dev -p 50051\" \"tsx src/ws-server/index.ts\"",
    "build": "next build",
    "start": "node scripts/kill-port.js && concurrently -n web,ws -c blue,green \"next start -p 50051\" \"tsx src/ws-server/index.ts\"",
    "pm2:start": "bash scripts/start.sh start",
    "pm2:stop": "bash scripts/start.sh stop",
    "pm2:restart": "bash scripts/start.sh restart",
    "pm2:logs": "pm2 logs devdash-local",
    "ws:start": "tsx src/ws-server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:apply": "node scripts/apply-migrations.mjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@dialout/shared": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.2",
    "firebase-admin": "^13.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.22.0",
    "next": "^15.3.2",
    "nodemailer": "^8.0.7",
    "otplib": "^12.0.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "xterm": "^5.3.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
