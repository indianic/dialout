{
  "name": "dialout",
  "version": "1.0.1",
  "description": "Dialout agent — reach your office, home or build machine from any browser or phone. Remote tmux terminals, live port checks, filesystem browsing, process control and HTTP tunnels. The agent dials out: no inbound ports, no VPN, no port forwarding.",
  "bin": {
    "dialout": "./bin/devdash-agent.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "scripts/postinstall.js",
    "README.md",
    "scripts/prepack.js"
  ],
  "scripts": {
    "prebuild": "npx tsc -p ../devdash-shared/tsconfig.json",
    "build": "tsc",
    "test": "npm run build && node --test",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "node scripts/prepack.js"
  },
  "keywords": [
    "dialout",
    "remote-development",
    "remote-access",
    "self-hosted",
    "developer-tools",
    "tmux",
    "terminal",
    "web-terminal",
    "port-scanner",
    "localhost-tunnel",
    "http-tunnel",
    "devops-dashboard",
    "claude-code",
    "codex",
    "ai-agent",
    "agent",
    "daemon",
    "pty",
    "websocket"
  ],
  "author": {
    "name": "Sandeep Mundra",
    "email": "sandeep@indianic.com",
    "url": "https://www.indianic.com"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@dialout/shared": "^1.0.0",
    "commander": "^12.1.0",
    "node-pty": "^1.2.0-beta.12",
    "smol-toml": "^1.8.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.10",
    "typescript": "^5.8.3"
  },
  "homepage": "https://www.dialout.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indianic/dialout.git",
    "directory": "packages/devdash-agent"
  },
  "bundleDependencies": [
    "@dialout/shared"
  ],
  "contributors": [
    {
      "name": "IndiaNIC Infotech Ltd",
      "email": "hello@indianic.com",
      "url": "https://www.indianic.com"
    }
  ],
  "bugs": {
    "url": "https://github.com/indianic/dialout/issues",
    "email": "hello@indianic.com"
  }
}
