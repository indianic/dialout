# ─────────────────────────────────────────────────────────────────────────────
# DevDash environment configuration
# Copy this file to `.env` and fill in the values. Variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser (do NOT put secrets in them).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (the app uses Postgres via Drizzle, not SQLite).
#   local:  postgres://USER@localhost:5432/devdash
#   prod:   postgres://USER:PASS@HOST:5432/devdash
DATABASE_URL=postgres://localhost:5432/devdash

# Secret used to sign JWT session cookies. Use a long random string, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# ── Public URLs (browser-exposed) ────────────────────────────────────────────

# Base URL of the app, used to build links in OTP / password-reset / invite
# emails. IF UNSET IT FALLS BACK TO http://localhost:50051 — which is why reset
# emails show a localhost link. Set this per environment:
#   local:  http://localhost:50051
#   prod:   https://www.dialout.dev
NEXT_PUBLIC_APP_URL=http://localhost:50051

# WebSocket URL the browser connects to for live terminals / dashboard updates.
#   local:  ws://localhost:50052
#   prod:   wss://www.dialout.dev/ws
NEXT_PUBLIC_WS_URL=ws://localhost:50052

# ── Email / SMTP (OTP login, password reset, share invites) ──────────────────

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-or-api-key
# From address/name shown on outgoing mail (defaults: DevDash / noreply@devdash.local)
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=DevDash

# ── Ports & servers (optional — sensible defaults shown) ─────────────────────

# Next.js app port (kill-port + start scripts read this). Default 50051.
PORT=50051

# WebSocket server port. Default 50052.
WS_PORT=50052

# Interface the ws-server binds to. Default 127.0.0.1 (localhost-only): its HTTP
# relay endpoints run privileged commands on daemons and must NOT be exposed to
# the network. Next.js reaches it on localhost and Apache proxies /ws/ from the
# same host, so localhost is correct for the standard single-host deploy. Set to
# 0.0.0.0 ONLY if the ws-server runs on a different host than the web app, and
# firewall the port to trusted sources yourself.
WS_HOST=127.0.0.1

# Shared secret the Next.js app sends (as X-Internal-Token) and the ws-server
# verifies before running privileged relay endpoints (/scan, /check, /browse,
# /project-scan, /run-command). Optional — if unset it's auto-derived from
# JWT_SECRET (SHA-256), which is secure by default since JWT_SECRET is always
# set. Set a random value here only to rotate this token independently of
# JWT_SECRET.
# WS_INTERNAL_TOKEN=another-long-random-string

# Internal URL the Next API uses to reach the WebSocket server (tunnel proxy).
# Default http://localhost:50052 — only change if the ws-server runs elsewhere.
WS_SERVER_URL=http://localhost:50052

# Path prefix the tunnel rewrites asset/API URLs under. Default /ws.
WS_PATH_PREFIX=/ws

# PM2 process name (set by prod CI to distinguish deploys). Default devdash-local.
# APP_NAME=devdash-indianic-dev

# ── Enquiry forms ────────────────────────────────────────────────────────────

# Where the public contact / enterprise enquiry notifications are sent. Falls
# back to FROM_EMAIL, which is usually a noreply address nobody reads — so set
# this to a real inbox or the notifications go nowhere useful.
#
# The enquiry row is written to the database before either email is attempted,
# so a delivery failure loses the notification but never the enquiry. A row
# with a null notified_at is one that nobody was told about.
ENQUIRY_NOTIFY_EMAIL=

# ── Optional features ────────────────────────────────────────────────────────

# AES-256-GCM key for encrypting machine API keys at rest (copy-from-UI support).
# Any long random string; it's hashed to a 32-byte key. Falls back to JWT_SECRET
# if unset — set it separately to rotate encryption independently of JWT signing.
# SECRET_ENC_KEY=another-long-random-string

# Colon-separated folder roots the standalone project-scanner script crawls
# (like $PATH). Only used by scripts/project-scanner.mjs.
# PROJECT_ROOTS=/Users/me/projects:/Users/me/work

# Web push — powers "your agent is waiting for you" alerts.
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The same pair must be set in development and production, or existing
# subscriptions stop working. Push is simply disabled when these are unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Analytics (marketing site) ───────────────────────────────────────────────

# Google Tag Manager container, e.g. GTM-XXXXXXX. Set this OR the GA4 id below,
# not both — GTM wins when both are present, because loading GA4 directly *and*
# through a GTM container double-counts every pageview.
#
# Both are optional and both must be NEXT_PUBLIC_, since the tag runs in the
# browser and a measurement id is not a secret. Leaving them unset loads no
# Google script at all, which is the right default for a self-hosted instance.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Used only when
# NEXT_PUBLIC_GTM_ID is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Registration policy ──────────────────────────────────────────────────────

# Comma-separated emails that are always treated as instance administrators,
# regardless of the users.is_admin column. This is a RECOVERY path, not the
# normal one: admin is granted to the first account created on an empty
# instance, and managed from Settings after that. Set this only when the flag
# ended up on the wrong row and the alternative would be a psql session.
ADMIN_EMAILS=
